	"edit": {
		"sections": [
			{
				"description": "### Batch PAN-OS Upgrade \n\nThis incident starts the process of upgrading the PAN-OS devices in the environment. ",
				"fields": [
					{
						"fieldId": "incident_name",
						"isVisible": true
					},
					{
						"fieldId": "incident_type",
						"isVisible": true
					}
				],
				"isVisible": true,
				"name": "Basic Information",
				"query": null,
				"queryType": "",
				"readOnly": false,
				"type": ""
			},
			{
				"description": "Which devices should be upgraded. Devices can be selected by their Tags, or any valid TIM query that returns device indicators. You can test the query, and view the available device tags, on the [Threat Intel Page](/#/indicators).",
				"isVisible": true,
				"name": "Device Targets",
				"query": null,
				"queryType": "",
				"readOnly": false,
				"type": ""
			},
			{
				"description": "The PAN-OS software versions to upgrade the environment to. If not provided, you will be prompted to select the correct version based on the available software images.\n\nIf provided, the playbook will not prompt for the upgrade versions, useful if this is being run as a job.",
				"isVisible": true,
				"name": "Target Versions",
				"query": null,
				"queryType": "",
				"readOnly": false,
				"type": ""
			},
			{
				"description": "### Warning\n\nThis Switch will automatically start the entire upgrade process for all the devices captured by this upgrade incident. This includes potentially impacting High-Availability operations and system restarts.\n\nMake sure you know what you're doing if you select it!",
				"isVisible": true,
				"name": "Enable Automatic Upgrades",
				"query": null,
				"queryType": "",
				"readOnly": false,
				"type": ""
			}
		]
	},
